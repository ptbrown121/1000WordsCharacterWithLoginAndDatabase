{
  "functions": {
    "api/ai/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/keepalive", "schedule": "0 9 * * *" },
    { "path": "/api/cron/backup", "schedule": "0 10 * * 1" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
